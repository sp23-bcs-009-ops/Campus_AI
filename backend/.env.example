# ── LLM provider ─────────────────────────────────────────────
# Demo day: change these 2 lines to switch from local Ollama to OpenAI
LLM_PROVIDER=ollama
OPENAI_API_KEY=

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.2:1b
OLLAMA_FALLBACK_MODEL=llama3.1
OLLAMA_HOST=http://127.0.0.1:11434

# ── Security ─────────────────────────────────────────────────
# Set a key to require the X-API-Key header on all data endpoints.
# Leave empty during local dev to keep the API open.
CAMPUS_AI_API_KEY=
RATE_LIMIT=20/minute

# ── RAG ──────────────────────────────────────────────────────
CHROMA_DIR=./chroma_db
RAG_TOP_K=4

# ── Memory ───────────────────────────────────────────────────
MEMORY_WINDOW=8
